[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
authors = [{ name = "{{ author_name }}" }]
{%- if license == "MIT" %}
license = "MIT"
license-files = ["LICENSE"]
{%- elif license == "Apache-2.0" %}
license = "Apache-2.0"
license-files = ["LICENSE"]
{%- endif %}
dependencies = [
{%- if project_type == "service" %}
  # Web service: the framework is a runtime dependency because images install no extras
  "fastapi>=0.165",
  "uvicorn[standard]>=0.54",
  # Typed settings that fail fast at startup (reads .env.<APP_ENV> via python-dotenv)
  "pydantic-settings>=2.16",
{%- endif %}
{%- if project_type == "notebooks" %}
  # Notebook runtime
  "jupyterlab>=4.6.6",
  "ipykernel>=7.4",
  # Data stack
  "numpy>=2.5",
  "pandas>=3.1",
{%- endif %}
  # HTTP client with retries: the common path for model and tool calls
  "httpx>=0.28.1",
  "tenacity>=9.2",
  # Validation at every boundary
  "pydantic>=2.14",
{%- if project_type != "service" %}
  "python-dotenv>=1.2.4",
{%- endif %}
  # Readable CLI output and tracebacks
  "rich>=15.0",
{%- if project_type != "notebooks" %}
  # Command-line entry point
  "typer>=0.29",
{%- endif %}
{%- if ai_kind == "lancedb" %}
  # AI retrieval stack (README "AI stack"): embedded vector store + local static embeddings.
  # model2vec, not sentence-transformers: no PyTorch, whose Linux wheels pull ~4 GB of CUDA.
  "lancedb>=0.41",
  "model2vec>=0.10",
  "huggingface-hub>=2.4",              # downloads the model at a pinned revision
{%- elif ai_kind == "chromadb" %}
  # AI retrieval stack (README "AI stack"): embedded vector store with its built-in embedder.
  # Pinned to Python <=3.14 by copier.yml: its onnxruntime dependency has no 3.15 wheels yet.
  "chromadb>=1.5.9",
{%- endif %}
{%- if ai_kind != "none" %}
  # PDF text and tables; web search for retrieval-augmented answers
  "pdfplumber>=0.11.11",
  "tavily-python>=0.8.5",
{%- endif %}
]
{%- if project_type != "notebooks" %}

[project.scripts]
{{ project_slug }} = "{{ package_name }}.cli:app"
{%- endif %}
{%- if project_type == "service" %}

[project.optional-dependencies]       # optional features: uv sync --extra ai
ai = ["numpy>=2.5", "pandas>=3.1"]
{%- elif project_type == "notebooks" %}

[project.optional-dependencies]       # optional features: uv sync --extra docs
docs = ["nbconvert>=7.17.2"]
{%- endif %}

# Version floors are the latest releases at the template release, and never below a version with a
# published security fix. uv.lock pins the exact versions; `uv lock --upgrade` moves them forward.
[dependency-groups]                   # tooling: `uv sync` installs dev; nothing here ships
dev = [
  "pytest>=9.2",
  "pytest-cov>=7.1",
  "pytest-asyncio>=1.5",
  "ruff>=0.17.6",
  "mypy>=2.4",
  "pre-commit>=4.7",
{%- if project_type == "service" %}
  "httpx2>=2.16.2",                   # backend for FastAPI's TestClient (Starlette 1.10+ deprecates httpx there)
{%- endif %}
]
security = ["pip-audit>=2.10.1", "bandit>=1.9.4"]
{%- if project_type == "notebooks" %}
notebooks = ["nbqa>=1.10", "nbstripout>=0.9.2", "jupyterlab-git>=0.55"]
{%- endif %}

{%- if project_type == "notebooks" %}

[tool.uv]
default-groups = ["dev", "notebooks"]   # plain `uv sync` (and `uv sync --locked` in CI) keeps notebook tooling
{%- endif %}

[build-system]
requires = ["setuptools>=84.2"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]
{%- if project_type == "library" %}

[tool.setuptools.package-data]
{{ package_name }} = ["py.typed"]
{%- endif %}

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
respect-gitignore = true

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "SIM", "N", "S", "RUF"]   # S = security rules
[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]                 # assert is how pytest works

[tool.ruff.format]
quote-style = "double"
indent-style = "space"

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
packages = ["{{ package_name }}"]
mypy_path = "src"
warn_unused_configs = true
{%- if project_type == "service" %}
plugins = ["pydantic.mypy"]
{%- endif %}
{%- if ai_kind != "none" %}

[[tool.mypy.overrides]]               # these libraries ship without type information
module = ["pdfplumber.*", "tavily.*"]
ignore_missing_imports = true
{%- endif %}

[tool.pytest.ini_options]
minversion = "9.2"
testpaths = ["tests"]
addopts = "-ra --strict-markers --cov --cov-report=term-missing"
asyncio_default_fixture_loop_scope = "function"
xfail_strict = true
markers = ["live: calls a real external API (needs credentials; excluded from CI)"]

[tool.coverage.run]
branch = true
source = ["src"]

[tool.coverage.report]
show_missing = true
skip_covered = true
fail_under = {{ coverage_threshold }}
