{
  "name": "{{ project_slug }}-dev",
  "build": { "dockerfile": "../.container/Containerfile", "context": "..", "target": "dev" },
  "runArgs": ["--userns=keep-id"],
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,Z",
  "workspaceFolder": "/app",
  "postCreateCommand": "uv sync --locked{% if project_type == 'notebooks' %} --group notebooks{% endif %} && uv run pre-commit install",
  "customizations": {
    "vscode": {
      "settings": { "python.defaultInterpreterPath": "/opt/venv/bin/python" },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"{% if project_type == "notebooks" %},
        "ms-toolsai.jupyter"{% endif %}
      ]
    }
  }
}
