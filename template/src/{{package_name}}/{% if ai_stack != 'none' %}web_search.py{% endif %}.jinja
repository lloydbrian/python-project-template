"""Web search through Tavily, for retrieval-augmented answers that need current information.

The API key comes from `TAVILY_API_KEY` (a `.env.dev` file locally, `podman secret` in a
container). It is never logged, and it is never part of a URL.
"""

from __future__ import annotations

import os
from dataclasses import dataclass

from tavily import TavilyClient


@dataclass(frozen=True)
class WebResult:
    title: str
    url: str
    content: str
    score: float


class MissingApiKeyError(RuntimeError):
    """Raised when no Tavily API key is configured."""


def search_web(query: str, max_results: int = 5, api_key: str | None = None) -> list[WebResult]:
    """Top web results for `query`. Pass `api_key`, or set TAVILY_API_KEY."""
    key = api_key or os.environ.get("TAVILY_API_KEY")
    if not key:
        raise MissingApiKeyError(
            "Set TAVILY_API_KEY (in .env.dev, or as a podman secret) to use web search"
        )
    response = TavilyClient(api_key=key).search(query=query, max_results=max_results)
    return [
        WebResult(
            title=str(r.get("title", "")),
            url=str(r.get("url", "")),
            content=str(r.get("content", "")),
            score=float(r.get("score", 0.0)),
        )
        for r in response.get("results", [])
    ]
