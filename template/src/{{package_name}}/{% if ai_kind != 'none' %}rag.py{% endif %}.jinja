@dataclass(frozen=True)
class Hit:
    """One search result. `distance`: lower means closer to the query."""

    id: str
    text: str
    distance: float


{%- if ai_kind == "lancedb" %}


# LanceDB's embedding helpers (register, create, SourceField, VectorField) are untyped, hence
# the targeted `type: ignore[no-untyped-call]` comments below; everything else is type-checked.


@lru_cache(maxsize=4)
def _load_model(name: str, revision: str) -> StaticModel:  # pragma: no cover - downloads
    """Download (once, then from cache) the model files at `revision` and load them."""
    return StaticModel.from_pretrained(snapshot_download(name, revision=revision))


@register("model2vec")  # type: ignore[no-untyped-call]
class Model2VecEmbeddings(TextEmbeddingFunction):
    """LanceDB embedding function for model2vec static models (registered as "model2vec").

    The registry name and fields are saved in each table's schema, so a store reopens with the
    same model and revision it was created with.
    """

    name: str = DEFAULT_MODEL
    revision: str = MODEL_REVISION

    def ndims(self) -> int:
        return int(self._model().dim)

    def generate_embeddings(self, texts: Sequence[str]) -> list[list[float]]:  # type: ignore[override]
        return cast(list[list[float]], self._model().encode(list(texts)).tolist())

    def _model(self) -> StaticModel:
        return _load_model(self.name, self.revision)


def default_embedder() -> EmbeddingFunction:
    """potion-retrieval-32M through model2vec, at the pinned revision.

    LanceDB requires `.create()`: it records the function's settings in the table schema.
    """
    return cast(EmbeddingFunction, Model2VecEmbeddings.create())  # type: ignore[no-untyped-call]


class DocumentStore:
    """Embedded LanceDB table (files under `path`, default VECTOR_STORE_PATH; no server)."""

    def __init__(
        self,
        path: str | Path | None = None,
        table: str = "documents",
        embedder: EmbeddingFunction | None = None,
    ) -> None:
        emb = embedder or default_embedder()

        class Document(LanceModel):  # schema: LanceDB fills `vector` from `text` automatically
            id: str
            text: str = emb.SourceField()  # type: ignore[no-untyped-call]
            vector: Vector(emb.ndims()) = emb.VectorField()  # type: ignore[valid-type,no-untyped-call]

        db = lancedb.connect(str(path or default_store_path()))
        self._table = db.create_table(table, schema=Document, exist_ok=True)

    def add(self, texts: Sequence[str], ids: Sequence[str] | None = None) -> list[str]:
        """Store texts (embedded on write); returns their ids."""
        keys = list(ids) if ids is not None else [uuid4().hex for _ in texts]
        self._table.add([{"id": k, "text": t} for k, t in zip(keys, texts, strict=True)])
        return keys

    def search(self, query: str, k: int = 5) -> list[Hit]:
        """The k stored texts closest to `query`."""
        rows: list[dict[str, Any]] = self._table.search(query).limit(k).to_list()
        return [Hit(id=r["id"], text=r["text"], distance=float(r["_distance"])) for r in rows]

    def count(self) -> int:
        return int(self._table.count_rows())


def warm_up() -> None:  # pragma: no cover - downloads the model; run by the image build
    """Download and load the embedding model once (used when building the container image)."""
    _load_model(DEFAULT_MODEL, MODEL_REVISION).encode(["warm-up"])
