"""Retrieval helpers: a small document store, PDF text extraction and text chunking.

Why a wrapper: the rest of the code depends on `DocumentStore.add()` and `.search()`, not on
{% if ai_stack == "lancedb" %}LanceDB{% else %}ChromaDB{% endif %}'s own API, so changing the vector store (for example ChromaDB -> LanceDB to move to
Python 3.15) touches this one file.

Embeddings run locally with all-MiniLM-L6-v2: 384 dimensions, English-focused, and input longer
than 256 tokens is cut off, so split long documents with `chunk_text()` before adding them. The
model (about 80 MB) is downloaded on first use and cached; container images bake it in.
"""

from __future__ import annotations

from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Any{% if ai_stack == 'lancedb' %}, cast{% endif %}
from uuid import uuid4

{%- if ai_stack == "lancedb" %}

import lancedb
from lancedb.embeddings import EmbeddingFunction, get_registry
from lancedb.pydantic import LanceModel, Vector
{%- else %}

import chromadb
from chromadb.api.types import Documents, EmbeddingFunction
from chromadb.config import Settings
{%- endif %}

DEFAULT_MODEL = "all-MiniLM-L6-v2"


@dataclass(frozen=True)
class Hit:
    """One search result. `distance`: lower means closer to the query."""

    id: str
    text: str
    distance: float


{%- if ai_stack == "lancedb" %}


# LanceDB's embedding helpers (create, SourceField, VectorField) are untyped, hence the targeted
# `type: ignore[no-untyped-call]` comments below; everything else is fully type-checked.


def default_embedder() -> EmbeddingFunction:
    """all-MiniLM-L6-v2 through sentence-transformers, on CPU, with normalised vectors."""
    factory = get_registry().get("sentence-transformers")
    embedder = factory.create(name=DEFAULT_MODEL, device="cpu")  # type: ignore[no-untyped-call]
    return cast(EmbeddingFunction, embedder)


class DocumentStore:
    """Embedded LanceDB table (files under `path`, no server). Embeds text on add and search."""

    def __init__(
        self,
        path: str | Path = "data/vectors",
        table: str = "documents",
        embedder: EmbeddingFunction | None = None,
    ) -> None:
        emb = embedder or default_embedder()

        class Document(LanceModel):  # schema: LanceDB fills `vector` from `text` automatically
            id: str
            text: str = emb.SourceField()  # type: ignore[no-untyped-call]
            vector: Vector(emb.ndims()) = emb.VectorField()  # type: ignore[valid-type,no-untyped-call]

        db = lancedb.connect(str(path))
        self._table = db.create_table(table, schema=Document, exist_ok=True)

    def add(self, texts: Sequence[str], ids: Sequence[str] | None = None) -> list[str]:
        """Store texts (embedded on write); returns their ids."""
        keys = list(ids) if ids is not None else [uuid4().hex for _ in texts]
        self._table.add([{"id": k, "text": t} for k, t in zip(keys, texts, strict=True)])
        return keys

    def search(self, query: str, k: int = 5) -> list[Hit]:
        """The k stored texts closest to `query`."""
        rows: list[dict[str, Any]] = self._table.search(query).limit(k).to_list()
        return [Hit(id=r["id"], text=r["text"], distance=float(r["_distance"])) for r in rows]

    def count(self) -> int:
        return int(self._table.count_rows())


def warm_up() -> None:  # pragma: no cover - downloads the model; run by the image build
    """Download and load the embedding model once (used when building the container image)."""
    default_embedder().compute_source_embeddings(["warm-up"])
{%- else %}


class DocumentStore:
    """Embedded ChromaDB collection (files under `path`, no server).

    Only the embedded `PersistentClient` is used. Do not run ChromaDB as a server: the advisories
    excepted in `.pip-audit-ignore` affect the server, which is why they are acceptable here.
    """

    def __init__(
        self,
        path: str | Path = "data/vectors",
        collection: str = "documents",
        embedder: EmbeddingFunction[Documents] | None = None,
    ) -> None:
        client = chromadb.PersistentClient(
            path=str(path),
            settings=Settings(anonymized_telemetry=False),  # no usage data leaves this machine
        )
        # No embedder given: Chroma's built-in all-MiniLM-L6-v2 (ONNX, CPU) is used.
        kwargs: dict[str, Any] = {} if embedder is None else {"embedding_function": embedder}
        self._collection = client.get_or_create_collection(collection, **kwargs)

    def add(self, texts: Sequence[str], ids: Sequence[str] | None = None) -> list[str]:
        """Store texts (embedded on write); returns their ids."""
        keys = list(ids) if ids is not None else [uuid4().hex for _ in texts]
        if len(keys) != len(texts):
            raise ValueError("ids and texts must have the same length")
        self._collection.add(ids=keys, documents=list(texts))
        return keys

    def search(self, query: str, k: int = 5) -> list[Hit]:
        """The k stored texts closest to `query`."""
        result = self._collection.query(query_texts=[query], n_results=k)
        ids = result["ids"][0]
        documents = (result["documents"] or [[]])[0]
        distances = (result["distances"] or [[]])[0]
        return [
            Hit(id=i, text=d or "", distance=float(s))
            for i, d, s in zip(ids, documents, distances, strict=True)
        ]

    def count(self) -> int:
        return int(self._collection.count())


def warm_up() -> None:  # pragma: no cover - downloads the model; run by the image build
    """Download and load Chroma's built-in embedding model once (used by the image build)."""
    from chromadb.utils.embedding_functions import DefaultEmbeddingFunction

    DefaultEmbeddingFunction()(["warm-up"])
{%- endif %}


def chunk_text(text: str, max_words: int = 180, overlap: int = 30) -> list[str]:
    """Split text into overlapping word windows that stay under the model's 256-token limit."""
    if max_words <= overlap or overlap < 0:
        raise ValueError("need max_words > overlap >= 0")
    words = text.split()
    step = max_words - overlap
    return [
        " ".join(words[i : i + max_words]) for i in range(0, max(len(words) - overlap, 1), step)
    ]


def pdf_text(path: str | Path) -> str:
    """Text of every page of a PDF (pdfplumber keeps reading order and handles tables well)."""
    import pdfplumber

    with pdfplumber.open(str(path)) as pdf:
        return "\n\n".join(page.extract_text() or "" for page in pdf.pages)
