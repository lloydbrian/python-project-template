def test_tavily_key_is_masked() -> None:
    settings = Settings(tavily_api_key="tvly-test-not-real")
    assert "tvly-test-not-real" not in repr(settings)
    assert settings.tavily_api_key is not None
    assert settings.tavily_api_key.get_secret_value() == "tvly-test-not-real"
