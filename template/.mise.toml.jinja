# .mise.toml — pins the toolchain and defines every quality gate as a task.
# Generated by python-project-template {{ template_ref }}; tool pins are refreshed by `copier update`.
# Why mise: one file pins Python and the CLI tools for laptops and CI alike, and runs the same
# task names everywhere, so "works on my machine" and "works in CI" are the same claim.

[tools]
python = "{{ python_version }}"   # keep in step with requires-python, the base image and ruff/mypy targets
uv = "{{ uv_version }}"           # environments, resolution and the lockfile
{%- if has_container %}
trivy = "{{ trivy_version }}"     # image vulnerability scanner and SBOM generator (local and CI)
{%- endif %}
gitleaks = "{{ gitleaks_version }}"   # full-history secret scan in `mise run ci` (the hook only sees staged changes)

[env]
PYTHONDONTWRITEBYTECODE = "1"
PYTHONUNBUFFERED = "1"

[tasks.bootstrap]
description = "Create .venv, lock if needed, install deps and git hooks (once per clone)"
run = """
[ -f uv.lock ] || uv lock
uv sync
uv run pre-commit install
{%- if has_container %}
uv run python tools/check_scan_exceptions.py --stamp .pip-audit-ignore
{%- endif %}
"""

[tasks.format]
description = "Auto-format code"
run = "uv run ruff format ."

[tasks.lint]
description = "Lint (fails on issues)"
run = "uv run ruff check ."

[tasks.type]
description = "Static type check (mypy strict)"
run = "uv run mypy"

[tasks.test]
description = "Unit tests with coverage (fails under {{ coverage_threshold }}%)"
run = "uv run pytest"

[tasks.security]
description = "Dependency audit and code security scan (fails on findings)"
run = """
{%- if has_container %}
uv run python tools/check_scan_exceptions.py .pip-audit-ignore
uv run --group security pip-audit $(uv run python tools/check_scan_exceptions.py --pip-audit-args .pip-audit-ignore)
{%- else %}
uv run --group security pip-audit
{%- endif %}
uv run --group security bandit -q -r src
"""
{%- if has_container %}

[tasks.image]
description = "Build the {% if project_type == 'notebooks' %}lab{% else %}production{% endif %} image with Podman (OS packages refreshed at most daily)"
{%- if ai_kind == "none" %}
run = "podman build --pull=newer --build-arg OS_REFRESH=$(date -u +%F) -f .container/Containerfile --target {% if project_type == 'notebooks' %}lab{% else %}prod{% endif %} -t {{ project_slug }}:dev ."
{%- else %}
run = """
set -eu
podman build --pull=newer --build-arg OS_REFRESH=$(date -u +%F) -f .container/Containerfile --target {% if project_type == 'notebooks' %}lab{% else %}prod{% endif %} -t {{ project_slug }}:dev .
# The embedding model must be baked in: embed and search with no network on a read-only filesystem
podman run --rm --read-only --tmpfs /tmp --network=none --cap-drop=ALL {% if project_type == 'notebooks' %}--entrypoint python {{ project_slug }}:dev{% else %}{{ project_slug }}:dev python{% endif %} -c \\
  "from {{ package_name }}.rag import DocumentStore; s = DocumentStore('/tmp/v'); s.add(['offline check']); assert s.search('offline', k=1); print('baked model: OK (offline, read-only)')"
"""
{%- endif %}

[tasks.scan]
description = "Fail on fixable HIGH/CRITICAL vulnerabilities; honours documented, unexpired exceptions"
run = """
set -eu
uv run python tools/check_scan_exceptions.py .trivyignore
# Same method as the release: an OCI archive, unpacked to an OCI layout (trivy reads a layout
# directory or a docker archive with --input, not an OCI archive file).
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
podman save --format oci-archive -o "$work/image.oci.tar" {{ project_slug }}:dev
mkdir "$work/oci" && tar -xf "$work/image.oci.tar" -C "$work/oci"
trivy image --input "$work/oci" --severity HIGH,CRITICAL --ignore-unfixed --ignorefile .trivyignore --exit-code 1
"""

[tasks.sbom]
description = "Write a CycloneDX SBOM of the image to sbom.cdx.json"
run = """
set -eu
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
podman save --format oci-archive -o "$work/image.oci.tar" {{ project_slug }}:dev
mkdir "$work/oci" && tar -xf "$work/image.oci.tar" -C "$work/oci"
trivy image --input "$work/oci" --format cyclonedx --output sbom.cdx.json
"""
{%- endif %}
{%- if project_type == "service" %}

[tasks.serve]
description = "Run the API locally with reload"
run = "uv run {{ project_slug }} serve --reload"

[tasks.smoke]
description = "Run the built image as in production (read-only, no capabilities) and check the health endpoints"
run = """
set -eu
name={{ project_slug }}-smoke
podman rm -f "$name" >/dev/null 2>&1 || true
podman run -d --name "$name" -p 127.0.0.1:{{ http_port }}:{{ http_port }} \
  --read-only --tmpfs /tmp --cap-drop=ALL --security-opt no-new-privileges \
  -e APP_ENV=test {{ project_slug }}:dev
trap 'status=$?; [ $status -eq 0 ] || podman logs "$name" 2>&1 | tail -40; podman rm -f "$name" >/dev/null 2>&1 || true' EXIT
for i in $(seq 1 60); do curl -fsS http://127.0.0.1:{{ http_port }}/health/ready >/dev/null 2>&1 && break; sleep 1; done
curl -fsS http://127.0.0.1:{{ http_port }}/health/live
echo
curl -fsS -D - -H 'X-Request-ID: smoke-test' http://127.0.0.1:{{ http_port }}/health/ready | grep -i '^x-request-id: smoke-test'
echo "smoke: OK"
"""
{%- endif %}
{%- if project_type == "notebooks" %}

[tasks.lab]
description = "Start JupyterLab with this repo's environment"
run = "uv run jupyter lab"

[tasks.kernel]
description = "Register this repo's kernel so JupyterLab and VS Code use the same environment"
run = "uv run python -m ipykernel install --user --name {{ project_slug }} --display-name '{{ kernel_display_name }}'"
{%- endif %}

[tasks.ci]
description = "Exactly what CI runs before any image work: hooks, types, tests, security, full-history secret scan"
run = """
uv sync --locked
uv run pre-commit run --all-files
uv run mypy
uv run pytest -m "not live"
{%- if has_container %}
uv run python tools/check_scan_exceptions.py .pip-audit-ignore
uv run --group security pip-audit $(uv run python tools/check_scan_exceptions.py --pip-audit-args .pip-audit-ignore)
{%- else %}
uv run --group security pip-audit
{%- endif %}
uv run --group security bandit -q -r src
gitleaks git --redact --no-banner .
"""
